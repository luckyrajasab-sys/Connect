# Connect Web App - Production OAuth Configuration

# Google OAuth 2.0 Client ID (from Google Cloud Console: https://console.cloud.google.com/apis/credentials)
# Add your Authorized JavaScript origins: http://localhost:3000 and your production domain (e.g., https://connect.app)
VITE_GOOGLE_CLIENT_ID=

# Apple Sign in with Apple Services ID (from Apple Developer Portal: https://developer.apple.com/account/resources/identifiers/list/serviceId)
VITE_APPLE_CLIENT_ID=

# Apple Return URL / Redirect URI
VITE_APPLE_REDIRECT_URI=http://localhost:3000
