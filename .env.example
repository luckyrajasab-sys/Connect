# ==============================================================================
# CONNECT CONTACT HUB — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Cloud Database & Authentication (Supabase / Cloud PostgreSQL)
# Get these from your Supabase Project Settings -> API: https://supabase.com/dashboard
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 2. Google OAuth 2.0 Client ID
# From Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Add Authorized JavaScript Origins: http://localhost:5173 and https://connect-two-topaz.vercel.app
VITE_GOOGLE_CLIENT_ID=

# 3. Apple Sign in with Apple Services ID
# From Apple Developer Portal: https://developer.apple.com/account/resources/identifiers/list/serviceId
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=https://connect-two-topaz.vercel.app
